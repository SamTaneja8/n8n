# Copy to .env (chmod 600). Never commit .env.

# Pinned n8n image. Upgrade by changing this line (README "Upgrading").
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.41.4

# Where n8n listens: VPS2's WireGuard address, reached by VPS1's Caddy.
N8N_BIND_HOST=10.20.0.2

N8N_HOST=n8n.webmanage.net
N8N_EDITOR_BASE_URL=https://n8n.webmanage.net
N8N_PROXY_HOPS=1
TIMEZONE=America/New_York

# Decrypts n8n's saved credentials. Must be the SAME value the data volume
# was created with (moved from reviewgate/.env on VPS1); a new key makes
# every saved credential unreadable. At least 32 characters.
N8N_ENCRYPTION_KEY=change-me-32-chars-minimum
